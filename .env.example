# Copy to .env.local for `npm run dev` against a Postgres server on this machine.
DATABASE_URL=postgresql://inventory:inventory@localhost:5432/inventory

# Set to true, or add ?sslmode=require on DATABASE_URL, for a hosted Postgres service.
# DATABASE_SSL=true

# Docker Compose password. Use letters and numbers, then run `docker compose up -d --build`.
# POSTGRES_USER=inventory
# POSTGRES_PASSWORD=inventory
# POSTGRES_DB=inventory
# PORT=43127
